# ─────────────────────────────────────────────────────────────────────────────
# RiggingCheck — Variáveis de Produção
# Copie para .env.production e preencha os valores reais.
# NUNCA commite o arquivo .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Domínio e URLs públicas ───────────────────────────────────────────────────
DOMAIN=riggingcheck.com
APP_BASE_URL=https://riggingcheck.com
VITE_FRONTEND_URL=https://riggingcheck.com
# IMPORTANTE: VITE_API_URL deve terminar com /api (sem barra final)
VITE_API_URL=https://riggingcheck.com/api

# ── PostgreSQL existente (container risecode_postgres na rede risecode_default) ─
# Rede Docker onde o PostgreSQL já está rodando (confirme com docker network ls)
POSTGRES_NETWORK=risecode_default
# Nome do container PostgreSQL (confirme com docker ps)
POSTGRES_CONTAINER=risecode_postgres
# URL JDBC — use o nome do container como host (ambos estão na mesma rede Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://risecode_postgres:5432/riggingcheck
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── SMTP (e-mail) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SMTP_FROM=noreply@riggingcheck.com

# ── Alertas por digest ────────────────────────────────────────────────────────
ALERT_DIGEST_ENABLED=false
ALERT_DIGEST_CRON=0 0 7 * * MON-FRI

# ── Stripe (pagamentos) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_BASIC=price_
STRIPE_PRICE_UNLIMITED=price_
STRIPE_SUCCESS_URL=https://riggingcheck.com/app/dashboard
STRIPE_CANCEL_URL=https://riggingcheck.com/pricing

# ── Let's Encrypt (Traefik) ───────────────────────────────────────────────────
# E-mail para notificações de renovação automática de certificado TLS
LETSENCRYPT_EMAIL=
